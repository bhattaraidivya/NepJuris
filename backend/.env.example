 =========================
# NepJuris Backend Config (hosted branch — Groq/Gemini instead of Ollama)
# =========================

# Groq (primary generation backend). Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Gemini (fallback, used only if Groq fails/times out/rate-limits).
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Comma-separated list of allowed frontend origins (CORS). Set this to
# your actual Vercel deployment URL in production.
# Defaults to http://localhost:5173,http://localhost if unset.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# Per-IP rate limits (see slowapi limit-string syntax). Upload is far
# more expensive than a chat query (embeds a whole PDF), hence stricter.
CHAT_RATE_LIMIT=10/minute
UPLOAD_RATE_LIMIT=3/hour
