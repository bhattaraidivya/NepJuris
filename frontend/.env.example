 NepJuris Frontend Config (hosted branch — Vercel + Render, no nginx)
# =========================

# Backend API base URL. On Vercel this is the bare Render backend URL
# (no /api suffix — there's no nginx reverse proxy in this topology).
VITE_API_BASE_URL=https://your-backend.onrender.com

# Shows a banner on the Docs page noting uploads are non-persistent,
# since Render's free tier has no persistent disk.
VITE_DEMO_MODE=true